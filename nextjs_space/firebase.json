{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/tsconfig.tsbuildinfo",
      "**/STYLE_GUIDE.md",
      "**/docs/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "maxInstances": 100,
      "minInstances": 0
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

