rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage mirrors Firestore's admin definition so platform admins can
    // investigate and repair user uploads. The admin registry supports
    // console-bootstrapped and UI-granted admins as well as custom claims.
    function hasActiveAppSession() {
      return request.auth != null
        && request.auth.token.get('appSessionId', null) is string
        && request.auth.token.get('appSessionNonce', null) is string
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.uid == request.auth.uid
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.deviceId == request.auth.token.appSessionId
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.sessionNonce == request.auth.token.appSessionNonce
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.get('revokedAt', null) == null
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.get('signedOutAt', null) == null
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.expiresAt is timestamp
        && firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.lastActiveAt is timestamp
        && request.time < firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.expiresAt
        && request.time < firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)/devices/$(request.auth.token.appSessionId)).data.lastActiveAt + duration.value(35, 'm');
    }

    function isAdmin() {
      return hasActiveAppSession()
        && (request.auth.token.admin == true
          || firestore.get(/databases/(default)/documents/admin/$(request.auth.uid)).data != null);
    }

    // Invitation files: public read (shared via links), event-host-only write.
    // The client-declared `hostId` metadata is NOT trusted on create — any
    // signed-in user could claim it and squat files under another event's
    // namespace. Create is authorized by a cross-service lookup of the event's
    // host in Firestore (firestore.get()); the metadata must still match the
    // caller so update/delete ownership (below) stays truthful.
    match /invitations/{eventId}/{filename} {
      allow read: if true;

      allow create: if hasActiveAppSession()
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.hostId == request.auth.uid
        && request.metadata.hostId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024; // 10 MB max

      // On update/delete: only the original owner (stored in metadata) can modify
      allow update, delete: if hasActiveAppSession()
        && resource.metadata.hostId == request.auth.uid;
    }

    // Event cover images (reserved prefix; not written by the app yet).
    // Same cross-service host verification as /invitations above.
    match /covers/{eventId}/{filename} {
      allow read: if true;
      allow create: if hasActiveAppSession()
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.hostId == request.auth.uid
        && request.metadata.hostId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if hasActiveAppSession()
        && resource.metadata.hostId == request.auth.uid;
    }

    // Admins are superusers across app storage; everyone else is denied unless
    // an explicit path rule above grants access.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
