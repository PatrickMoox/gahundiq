rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Admin = custom claim `admin: true` (set via Admin SDK) OR membership in
    // the Firestore `admin/{uid}` registry, which lets the first admin be
    // bootstrapped manually from the Firebase Console (Console writes bypass
    // security rules). The registry doc only needs to exist - its fields are
    // ignored. Revoke by deleting the document.
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admin/$(request.auth.uid)));
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function isEventHost(eventId) {
      return signedIn() && eventDoc(eventId).data.hostId == request.auth.uid;
    }

    function hostHasActivePremium(eventData) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(eventData.hostId);
      return exists(subscriptionPath)
        && get(subscriptionPath).data.get('tier', '') == 'premium'
        && !(get(subscriptionPath).data.get('status', '') in ['canceled', 'past_due'])
        && (get(subscriptionPath).data.get('currentPeriodEnd', null) == null
          || (get(subscriptionPath).data.get('currentPeriodEnd', null) is timestamp
            && get(subscriptionPath).data.get('currentPeriodEnd', null) > request.time));
    }

    function collaboratorLimit(eventData) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(eventData.hostId);
      return hostHasActivePremium(eventData)
        ? (get(subscriptionPath).data.get('billingCycle', 'per_event') == 'monthly' ? 5 : 3)
        : 1;
    }

    function hasCollaboratorSlot(eventId) {
      let event = eventDoc(eventId).data;
      let collaborators = event.get('collaboratorIds', []);
      return collaborators is list && collaborators.size() < collaboratorLimit(event);
    }

    function isEventCollaborator(eventId) {
      return signedIn()
        && 'collaboratorIds' in eventDoc(eventId).data
        && request.auth.uid in eventDoc(eventId).data.collaboratorIds;
    }

    function canUseEvent(eventId) {
      return isEventHost(eventId) || isEventCollaborator(eventId);
    }

    // Core planning is shared by default. Budget, vendors, guests, and gifts
    // require explicit host permission. The UI mirrors this default, but
    // these rules are the authorization boundary.
    function collaboratorSectionAllowed(eventId, section) {
      return isEventCollaborator(eventId)
        && eventDoc(eventId).data.get('collaboratorAccess', {})
          .get(request.auth.uid, {})
          .get(section, section in ['timeline', 'tasks', 'seating']);
    }

    function validPlanningReferences(eventId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let vendorPath = /databases/$(database)/documents/events/$(eventId)/vendors/$(request.resource.data.get('vendorId', ''));
      let budgetPath = /databases/$(database)/documents/events/$(eventId)/budget/$(request.resource.data.get('budgetItemId', ''));
      return (!changed.hasAny(['vendorId'])
          || request.resource.data.get('vendorId', null) == null
          || (request.resource.data.get('vendorId', null) is string
            && exists(vendorPath)
            && get(vendorPath).data.eventId == eventId))
        && (!changed.hasAny(['budgetItemId'])
          || request.resource.data.get('budgetItemId', null) == null
          || (request.resource.data.get('budgetItemId', null) is string
            && exists(budgetPath)
            && get(budgetPath).data.eventId == eventId))
        && (!changed.hasAny(['vendorId'])
          || isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'vendors'))
        && (!changed.hasAny(['budgetItemId'])
          || isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'budget'));
    }

    function validCollaboratorSelfJoinAccess(eventId) {
      let access = request.resource.data.get('collaboratorAccess', {});
      let priorAccess = resource.data.get('collaboratorAccess', {});
      let claim = get(/databases/$(database)/documents/collabClaims/$(eventId + '_' + request.auth.uid)).data;
      let userAccess = access.get(request.auth.uid, {});
      return access.diff(priorAccess).affectedKeys().hasOnly([request.auth.uid])
        && userAccess.keys().hasOnly(['budget', 'guests', 'gifts'])
        && (claim.get('shareBudget', false)
          ? userAccess.get('budget', false) == true
          : !('budget' in userAccess))
        && (claim.get('shareGuests', false)
          ? userAccess.get('guests', false) == true
          : !('guests' in userAccess))
        && (claim.get('shareGifts', false)
          ? userAccess.get('gifts', false) == true
          : !('gifts' in userAccess))
        && (claim.get('shareBudget', false) || claim.get('shareGuests', false) || claim.get('shareGifts', false)
          || !(request.auth.uid in access.keys()));
    }

    function publicGiftPageIsActive(eventId) {
      return exists(/databases/$(database)/documents/publicGiftPages/$(eventId))
        && get(/databases/$(database)/documents/publicGiftPages/$(eventId)).data.get('isActive', true) == true;
    }

    // Public gift pledges (written by anonymous guests from /gift/{eventId}):
    // shape + sanity bounds enforced here so guests cannot write arbitrary or
    // oversized junk into the host's gifts subcollection.
    function hasOnlyPublicGiftFields() {
      return request.resource.data.keys().hasOnly([
        'guestName', 'guestEmail', 'amount', 'currency', 'message',
        'giftType', 'status', 'createdAt'
      ])
      && request.resource.data.guestName is string
      && request.resource.data.guestName.size() > 0
      && request.resource.data.guestName.size() <= 100
      && (!('guestEmail' in request.resource.data)
        || request.resource.data.guestEmail == null
        || (request.resource.data.guestEmail is string
          && request.resource.data.guestEmail.size() <= 200))
      && request.resource.data.amount is number
      && request.resource.data.amount > 0
      && request.resource.data.amount <= 10000000
      && request.resource.data.currency is string
      && request.resource.data.currency.size() == 3
      && (!('message' in request.resource.data)
        || (request.resource.data.message is string
          && request.resource.data.message.size() <= 1000))
      && request.resource.data.giftType is string
      && request.resource.data.giftType in ['cash', 'honeymoon_fund', 'charity', 'experience']
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt is timestamp;
    }

    function validCollaborators(data) {
      return !('collaboratorIds' in data) || data.collaboratorIds is list;
    }

    function hostOnlyRemovesCollaborators() {
      let existing = resource.data.get('collaboratorIds', []);
      let requested = request.resource.data.get('collaboratorIds', []);
      return existing is list
        && requested is list
        && existing.hasAll(requested);
    }

    // Online invitation link (host-set external URL, e.g. Canva). Empty string
    // clears the link; otherwise it must be a bounded http(s) URL.
    function validOnlineInvitation(data) {
      return (!('onlineInvitationUrl' in data)
        || (data.onlineInvitationUrl is string
          && data.onlineInvitationUrl.size() <= 2048
          && (data.onlineInvitationUrl.size() == 0 || data.onlineInvitationUrl.matches('https?://.*'))))
        && (!('onlineInvitationLabel' in data)
          || (data.onlineInvitationLabel is string && data.onlineInvitationLabel.size() <= 80));
    }

    // Admins have unrestricted read/write access to ALL event data for support
    // purposes. This override is intentional: support staff may need to modify
    // any field on any event (including tier, hostId, plan limits, and
    // premium-gated subcollections) to resolve customer issues. The isAdmin()
    // check is placed FIRST in every canManageEvent() call and in each explicit
    // rule below so admins bypass all host/collaborator/plan restrictions.
    function canManageEvent(eventId) {
      return canUseEvent(eventId) || isAdmin();
    }

    function isPaidEvent(eventId) {
      return eventDoc(eventId).data.tier == 'premium';
    }

    function eventGuestLimit(data) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(data.hostId);
      return data.get('guestCapacityOverride', null) is number
        ? data.guestCapacityOverride
        : (exists(subscriptionPath)
        ? get(subscriptionPath).data.get('maxGuests', data.tier == 'premium' ? 250 : 25)
        : (data.tier == 'premium' ? 250 : 25));
    }

    // True when the signed-in user holds a premium entitlement the rules can
    // verify directly from the admin-managed `subscriptions/{uid}` doc:
    // tier premium, status not canceled/past_due, and currentPeriodEnd either
    // null/absent (open-ended grant) or a future timestamp. Mirrors
    // lib/plan-entitlements.ts isSubscriptionActive(). Identical get() calls
    // within one evaluation are deduped by the rules engine (1 billed read).
    // Without this check ANY user could create a tier:'premium' event and
    // unlock seating/budget/gifts/coordinator for free — the paywall MUST be
    // enforced here, not in the UI.
    function isSubscribed() {
      return signedIn()
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.get('tier', '') == 'premium'
        && !(get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.get('status', '') in ['canceled', 'past_due'])
        && (get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.get('currentPeriodEnd', null) == null
          || (get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.get('currentPeriodEnd', null) is timestamp
            && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.get('currentPeriodEnd', null) > request.time));
    }

    // Plan validation at event CREATE: guest capacity comes from the
    // host subscription override or the tier default;
    // 'premium' requires a verified premium subscription (admins bypass via
    // the isAdmin() branch in the create rule).
    function validEventPlan(data) {
      return !('guestCapacityOverride' in data)
        && !('invitationCapacityOverride' in data)
        && data.guestCount is number
        && data.guestCount <= eventGuestLimit(data)
        && (data.tier == 'premium' ? isSubscribed() : data.tier == 'free');
    }

    // Plan validation at event UPDATE: hosts cannot change tier anyway (it is
    // not in the host update key allowlist), so just re-check the free-tier
    // guest cap. Premium events stay editable for their host even if their
    // subscription later lapses — downgrade is an admin action.
    function validEventPlanForUpdate() {
      return request.resource.data.tier == resource.data.tier
        && request.resource.data.guestCount is number
        && request.resource.data.guestCount <= eventGuestLimit(resource.data);
    }

    // User profile data is private to the authenticated user.
    match /users/{userId} {
      allow read, create, update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Billing state and add-on entitlements are admin-managed or written by
    // trusted payment webhooks only. Clients cannot grant themselves capacity.
    match /subscriptions/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /events/{eventId} {
      // NOTE: The host check intentionally uses resource.data (not get() on the
      // event itself). get() via the {eventId} wildcard cannot be evaluated for
      // list/query operations, which made every query on /events fail with
      // "Missing or insufficient permissions" (rules are not filters). Using
      // resource.data.hostId lets the engine prove the rule from the client's
      // where('hostId', '==', uid) query constraint.
      allow read: if isAdmin()
        || (signedIn() && resource.data.hostId == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.get('collaboratorIds', []));
      // Ceremony creation is performed by the authenticated server endpoint,
      // which enforces the owner's active-ceremony allowance atomically.
      allow create: if isAdmin();
      // Admins bypass all host restrictions for support (any fields, any plan).
      allow update: if isAdmin() || (isEventHost(eventId)
        && request.resource.data.hostId == resource.data.hostId
        && validCollaborators(request.resource.data)
        && hostOnlyRemovesCollaborators()
        && validEventPlanForUpdate()
        && validOnlineInvitation(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'eventType', 'date', 'venue', 'coverImageUrl',
          'guestCount', 'updatedAt', 'collaboratorIds', 'collaboratorNames', 'collaboratorAccess', 'currency',
          'invitationUrl', 'invitationName', 'invitationUploadedAt',
          'onlineInvitationUrl', 'onlineInvitationLabel'
        ]))
        // Collaborator SELF-JOIN: an invited user may add ONLY themselves
        // (plus their self-reported display name), and only while a claim doc
        // exists that the rules proved against an accepted invite token. This
        // is what makes invite-by-link work without a backend.
        || (signedIn()
          && request.resource.data.hostId == resource.data.hostId
          && validCollaborators(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'collaboratorIds', 'collaboratorNames', 'collaboratorAccess', 'updatedAt'])
          && request.auth.uid in request.resource.data.get('collaboratorIds', [])
          && !(request.auth.uid in resource.data.get('collaboratorIds', []))
          && hasCollaboratorSlot(eventId)
          && exists(/databases/$(database)/documents/collabClaims/$(eventId + '_' + request.auth.uid))
          && validCollaboratorSelfJoinAccess(eventId)
          // collaboratorNames may only GROW by exactly the caller's own key:
          // keep every existing entry (hasAll), add at most one (size), and it
          // must be the caller's own (in keys) with a string display name.
          && request.resource.data.get('collaboratorNames', {}).keys().hasAll(
               resource.data.get('collaboratorNames', {}).keys())
          && request.resource.data.get('collaboratorIds', []).hasAll(
               resource.data.get('collaboratorIds', []))
          && request.resource.data.get('collaboratorIds', []).size() <=
               resource.data.get('collaboratorIds', []).size() + 1
          && request.resource.data.get('collaboratorNames', {}).keys().size() <=
               resource.data.get('collaboratorNames', {}).keys().size() + 1
          && request.auth.uid in request.resource.data.get('collaboratorNames', {}).keys()
          && request.resource.data.get('collaboratorNames', {}).get(request.auth.uid, '') is string);
      allow delete: if isAdmin() || isEventHost(eventId);

      // Section access: host/admin always; collaborators gated per section —
      // money sections (budget, vendors) are private unless explicitly opened.
      match /timeline/{recordId} {
        allow read: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'timeline');
        // Creates go through the authenticated server endpoint so free-plan
        // quotas cannot be bypassed by writing directly with the client SDK.
        allow create: if isAdmin();
        allow update: if (isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'timeline'))
          && validPlanningReferences(eventId);
        allow delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'timeline');
      }

      match /vendors/{recordId} {
        allow read: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'vendors');
        allow create: if isAdmin();
        allow update, delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'vendors');
      }

      match /seating/{recordId} {
        allow read, write: if (isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'seating'))
          && (isPaidEvent(eventId) || isAdmin());
      }

      match /tasks/{recordId} {
        allow read: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'tasks');
        allow create: if isAdmin();
        allow update: if (isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'tasks'))
          && validPlanningReferences(eventId);
        allow delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'tasks');
      }

      match /budget/{recordId} {
        // Budget is available on free plans up to the item cap, so item
        // creation is server-mediated rather than premium-only.
        allow read: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'budget');
        allow create: if isAdmin();
        allow update: if (isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'budget'))
          && validPlanningReferences(eventId);
        allow delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'budget');
      }

      match /guests/{recordId} {
        allow read: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests');
        allow create: if isAdmin();
        allow update, delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests');
      }

      // Digital invitations: token-keyed, guest-facing. The 40-char token IS
      // the capability - anyone holding the link can read the invite and
      // respond (RSVP only); hosts and collaborators with guest access manage
      // invite records. Invite count is metered by the plan's invite quota.
      match /invites/{token} {
        allow get: if isAdmin() || isEventHost(eventId)
          || collaboratorSectionAllowed(eventId, 'guests') || token.size() >= 32;
        allow list: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests');
        allow create: if (isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests'))
          && request.resource.data.token == token
          && request.resource.data.eventId == eventId
          && request.resource.data.token.size() >= 32;
        allow update: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests')
          || (token.size() >= 32
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp', 'respondedAt'])
            && request.resource.data.rsvp in ['pending', 'confirmed', 'declined']
            && request.resource.data.respondedAt is timestamp);
        allow delete: if isAdmin() || isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'guests');
      }

      // Gift records contain payment and guest data; only hosts/admins or
      // collaborators explicitly granted gift access may read them.
      match /gifts/{giftId} {
        allow read: if isAdmin() || (isPaidEvent(eventId)
          && (isEventHost(eventId) || collaboratorSectionAllowed(eventId, 'gifts')));
        allow create: if isAdmin() || (isPaidEvent(eventId)
          && publicGiftPageIsActive(eventId)
          && hasOnlyPublicGiftFields());
        allow update, delete: if isAdmin();
      }
    }

    // Collaboration invites: token-keyed, link-shared co-planner invites
    // (groom joining the bride's ceremony). The 40-char token IS the
    // capability. HOST-ONLY management — collaborators cannot extend the
    // guest-planner circle (privacy: the host decides who joins). The
    // invitee's only permitted update is accepting (proving they hold the
    // token and that the link hasn't expired); the host may only revoke.
    match /collabInvites/{token} {
      // Invitees read a document by its capability token. Hosts list their
      // event's invites using an eventId-filtered query; keeping list separate
      // avoids requiring that query to constrain document ids by token length.
      allow get: if signedIn() && token.size() >= 32;
      allow list: if isEventHost(resource.data.eventId);
      allow create: if signedIn()
        && isEventHost(request.resource.data.eventId)
        && hasCollaboratorSlot(request.resource.data.eventId)
        && !(request.auth.uid in eventDoc(request.resource.data.eventId).data.get('collaboratorIds', []))
        && request.resource.data.token == token
        && token.size() >= 32
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedBy == request.auth.uid
        && (!('shareBudget' in request.resource.data)
          || request.resource.data.shareBudget is bool)
        && (!('shareGuests' in request.resource.data)
          || request.resource.data.shareGuests is bool)
        && (!('shareGifts' in request.resource.data)
          || request.resource.data.shareGifts is bool)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly([
          'token', 'eventId', 'eventTitle', 'invitedBy', 'invitedByName',
          'shareBudget', 'shareGuests', 'shareGifts',
          'createdAt', 'expiresAt', 'status']);
      allow update: if isAdmin()
        // Inviter-side: revoke only (never flip a revoked invite back to pending).
        || (isEventHost(resource.data.eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'revoked'])
        // Invitee-side: accept only, only themselves, only before expiry. The
        // diff() key restriction plus the create rule's field whitelist fully
        // constrain the resulting document — no extra shape check needed.
        || (signedIn()
          && resource.data.status == 'pending'
          && resource.data.expiresAt is timestamp
          && request.time < resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedBy', 'acceptedAt', 'updatedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && hasCollaboratorSlot(resource.data.eventId)
          && !(request.auth.uid in eventDoc(resource.data.eventId).data.get('collaboratorIds', [])));
      allow delete: if isAdmin()
        || (resource.data.eventId is string && isEventHost(resource.data.eventId));
    }

    // Collaboration claims: written by the invitee in the same batch that
    // accepts the invite. getAfter() in the create rule verifies the invite
    // was accepted by THIS user for THIS event in the same atomic write, so a
    // claim can never exist without a legitimately accepted token. The event
    // self-join update then requires this doc to exist (see /events update).
    match /collabClaims/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && claimId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && (!('shareBudget' in request.resource.data)
          || request.resource.data.shareBudget is bool)
        && (!('shareGuests' in request.resource.data)
          || request.resource.data.shareGuests is bool)
        && (!('shareGifts' in request.resource.data)
          || request.resource.data.shareGifts is bool)
        && request.resource.data.keys().hasOnly([
          'eventId', 'uid', 'displayName', 'token', 'shareBudget', 'shareGuests', 'shareGifts', 'createdAt'])
        && hasCollaboratorSlot(request.resource.data.eventId)
        && !(request.auth.uid in eventDoc(request.resource.data.eventId).data.get('collaboratorIds', []))
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.acceptedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.eventId == request.resource.data.eventId
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.get('shareBudget', false) == request.resource.data.get('shareBudget', false)
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.get('shareGuests', false) == request.resource.data.get('shareGuests', false)
        && getAfter(/databases/$(database)/documents/collabInvites/$(request.resource.data.token)).data.get('shareGifts', false) == request.resource.data.get('shareGifts', false);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        // The event host removes claims when kicking a collaborator (so the
        // removed user cannot re-join via the stale claim).
        || (signedIn()
          && resource.data.eventId is string
          && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.hostId == request.auth.uid);
    }

    // Public vendor passes: token-keyed, vendor-facing. The token IS the
    // capability - anyone holding the link can read; hosts create their own
    // event's passes via vendor-section access (verified against the stored eventId).
    // On update the eventId is immutable so a pass can never be re-pointed at
    // another event after creation.
    match /publicVendorPasses/{token} {
      allow read: if token.size() >= 32;
      allow create: if isAdmin() || (request.resource.data.eventId is string
        && (isEventHost(request.resource.data.eventId)
          || collaboratorSectionAllowed(request.resource.data.eventId, 'vendors'))
        && request.resource.data.token == token && token.size() >= 32);
      allow update: if isAdmin() || (request.resource.data.eventId is string
        && (isEventHost(request.resource.data.eventId)
          || collaboratorSectionAllowed(request.resource.data.eventId, 'vendors'))
        && request.resource.data.token == token && token.size() >= 32
        && request.resource.data.eventId == resource.data.eventId);
      allow delete: if isAdmin()
        || (resource.data.eventId is string
          && (isEventHost(resource.data.eventId)
            || collaboratorSectionAllowed(resource.data.eventId, 'vendors')));
    }

    // Public gift pages: anyone can read (public); the doc id IS the event id,
    // so writes are bound to it — a page can never be created for or repointed
    // at a different event — and only the event's ACTUAL host (or admin)
    // writes. Ownership is verified against events/{eventId} itself: without
    // this check any signed-in user could publish a spoofed gift page (title,
    // venue, currency) under someone else's event id.
    match /publicGiftPages/{eventId} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
          && isEventHost(eventId)
          && request.resource.data.eventId == eventId
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120);
      allow update: if isAdmin()
        || (signedIn()
          && isEventHost(eventId)
          && request.resource.data.eventId == eventId
          && request.resource.data.hostId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Public reviews feed: drives the landing/auth social-proof stars. Anyone
    // can read the aggregate; only admins write (review moderation).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.rating is number
        && request.resource.data.rating >= 0.5 && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // Deny every collection not explicitly covered above to normal users.
    // The admin claim intentionally provides platform-wide control.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
