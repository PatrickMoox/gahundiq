# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. NEVER commit .env.local.
#
# The NEXT_PUBLIC_* values below are the Firebase *web* config: they are
# designed to be public and ship inside the client bundle. Your data is
# protected by firestore.rules + storage.rules, not by hiding these.
# ---------------------------------------------------------------------------

# Public site URL (used for Open Graph metadata, sitemap.xml and robots.txt —
# set to your deploy domain in production, otherwise links point at localhost).
NEXT_PUBLIC_SITE_URL=

# Firebase (Firebase Console > Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server-side / ops only. Never prefix these with NEXT_PUBLIC_.
# Used by scripts/set-admin-claim.ts (service-account key from Firebase Console
# > Project settings > Service accounts > Generate new private key).
# Leave commented out to use the default: scripts/serviceAccountKey.json
# ---------------------------------------------------------------------------
# SERVICE_ACCOUNT_KEY_PATH=scripts/serviceAccountKey.json

# ---------------------------------------------------------------------------
# NOT IMPLEMENTED YET — keep these EMPTY.
# No code in this repository reads them today: there is no payment provider,
# no SMS sending and no Gemini/LLM call. The names are reserved only. Do not
# paste real credentials into a file that will be shared.
# ---------------------------------------------------------------------------
# Stripe (planned)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Twilio (planned)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Gemini AI (planned)
GEMINI_API_KEY=
